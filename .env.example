# Configuração local da API. Não versione o arquivo .env.
APP_ENV=development
ADMIN_TOKEN_SECRET=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# O banco fica em %LOCALAPPDATA%/GymPresence/gym_presence.db no Windows.
# DATABASE_URL é opcional; se usada, escolha um arquivo SQLite fora de pastas sincronizadas.
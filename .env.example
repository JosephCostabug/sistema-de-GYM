# Copie para .env no desenvolvimento; em produção, prefira um gestor de segredos.
APP_ENV=development
DATABASE_URL=sqlite:///./gym_presence.db
ADMIN_TOKEN_SECRET=
# Supabase: copie a URI PostgreSQL de Project Settings > Database para DATABASE_URL.
# Inclua sslmode=require; nunca use a chave anon/service_role no lugar da URI do banco.